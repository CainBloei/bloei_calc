{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/.auth/login/*", "/.auth/logout/*"]
  },
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  }
}